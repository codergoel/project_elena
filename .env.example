# Copy to `.env` at repo root and adjust if needed.
# Use with: docker compose -f infra/compose.yaml --env-file .env up --build
#
# Values below match the default `api` service in Compose (Postgres/Redis hostnames
# are reachable only from other containers). If you run the API on the host with
# `uv run uvicorn …` while Compose runs only Postgres + Redis, set:
#   DATABASE_URL=postgresql://elena:elena_dev@localhost:5432/elena
#   REDIS_URL=redis://localhost:6379/0

API_PORT=8000
DATABASE_URL=postgresql://elena:elena_dev@postgres:5432/elena
REDIS_URL=redis://redis:6379/0

POSTGRES_USER=elena
POSTGRES_PASSWORD=elena_dev
POSTGRES_DB=elena

# Next.js (browser on your machine — API port published from Compose)
NEXT_PUBLIC_API_URL=http://localhost:8000
