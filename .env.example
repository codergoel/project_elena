# Copy to `.env` at repo root and adjust if needed.
# Use with: docker compose -f infra/compose.yaml --env-file .env up --build
#
# API uses async SQLAlchemy with asyncpg — keep `+asyncpg` in DATABASE_URL.
# If you run `uv run uvicorn …` on the host while Compose runs only Postgres + Redis, set:
#   DATABASE_URL=postgresql+asyncpg://elena:elena_dev@localhost:5432/elena
#   REDIS_URL=redis://localhost:6379/0

API_PORT=8000
DATABASE_URL=postgresql+asyncpg://elena:elena_dev@postgres:5432/elena
REDIS_URL=redis://redis:6379/0

AUTH_MODE=development
FILE_DOWNLOAD_SIGNING_SECRET=dev-insecure-download-secret-change-me
PUBLIC_API_BASE_URL=http://localhost:8000

POSTGRES_USER=elena
POSTGRES_PASSWORD=elena_dev
POSTGRES_DB=elena

# Next.js (browser on your machine — API port published from Compose)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production-style JWT validation (set AUTH_MODE=jwks)
# JWKS_URL=https://your-idp/.well-known/jwks.json
# JWT_AUDIENCE=your-api-audience

# Browser origin(s) for API CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set true on private networks only to expose GET /metrics for Prometheus (default false).
# EXPOSE_PROMETHEUS_METRICS=false

# Phase 8 variant JD paste limit (characters)
JD_MAX_PLAINTEXT_CHARS=200000

IMPORT_MAX_PDF_BYTES=6000000
IMPORT_MAX_EXTRACTED_CHARS=200000
IMPORT_UPLOAD_QUOTA_PER_MINUTE_PER_USER=40
IMPORT_LLM_QUOTA_PER_MINUTE_PER_USER=20

# Gemini (import LLM + Phase 7.3 editor agent — BYOK — never commit keys)
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI-compatible chat API for structured import preview (BYOK — never commit keys)
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
